<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="expo.modules.adhannative" >

    <uses-sdk android:minSdkVersion="24" />
    <!-- Алармата с пълния езан (етап 5) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+: за да види дали на телефона има Google Play Services (Huawei без Google) -->
    <queries>
        <package android:name="com.google.android.gms" />
    </queries>

    <application>

        <!-- Екранът „Аларма“ върху заключения екран; отделна задача, за да не вади цялото приложение -->
        <activity
            android:name="expo.modules.adhannative.AlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity="${applicationId}.alarm"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:turnScreenOn="true" />

        <!-- Пуска езана и вибрацията, докато свърши (или „Спри“) -->
        <service
            android:name="expo.modules.adhannative.AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Будилникът на Android (setAlarmClock) вика този receiver в часа на молитвата -->
        <receiver
            android:name="expo.modules.adhannative.AlarmReceiver"
            android:exported="false" />

        <!-- След рестарт, обновяване на приложението, смяна на часа или на разрешението – алармите наново -->
        <receiver
            android:name="expo.modules.adhannative.BootReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>