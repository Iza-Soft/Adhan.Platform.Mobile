<?xml version="1.0" encoding="utf-8"?>
<!-- Шрифтовете са системните: widget-ите не могат да зареждат свои шрифтове (RemoteViews). -->
<!-- Widget „Следваща“ 2×2 (етап 8) – по mockup-а. Текстовете ги задава PrayerWidgets.kt. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/ezan_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/ezan_widget_bg_dhuhr"
  android:clipToOutline="true">

  <ImageView
    android:id="@+id/ezan_dome"
    android:layout_width="130dp"
    android:layout_height="65dp"
    android:layout_gravity="bottom|end"
    android:layout_marginEnd="-10dp"
    android:layout_marginBottom="-2dp"
    android:alpha="0.22"
    android:importantForAccessibility="no"
    android:src="@drawable/ezan_widget_dome" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="14dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:baselineAligned="true">
      <TextView
          android:id="@+id/ezan_arabic"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:textStyle="bold"
          android:textSize="24sp"
          android:textColor="#D4A857"
          android:maxLines="1"
          android:ellipsize="end"
          android:text="العصر"
          android:layout_weight="1" />
      <TextView
          android:id="@+id/ezan_place"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif"
          android:textStyle="bold"
          android:textSize="9.5sp"
          android:textColor="#C7F2EFE8"
          android:maxLines="1"
          android:ellipsize="end"
          android:text="@string/ezan_widget_sample_place"
          android:letterSpacing="0.1" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">
      <TextView
          android:id="@+id/ezan_name"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif"
          android:textStyle="bold"
          android:textSize="17sp"
          android:textColor="#F2EFE8"
          android:ellipsize="end"
          android:text="@string/ezan_widget_sample_name"
          android:maxLines="2" />
      <TextView
          android:id="@+id/ezan_at"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
          android:textSize="17sp"
          android:textColor="#C7F2EFE8"
          android:maxLines="1"
          android:ellipsize="end"
          android:text="@string/ezan_widget_sample_at"
          android:layout_marginStart="5dp"
          android:fontFeatureSettings="tnum" />
    </LinearLayout>

    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />

    <Chronometer
        android:id="@+id/ezan_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
          android:textStyle="bold"
        android:fontFeatureSettings="tnum"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false"
        android:textSize="31sp"
        android:textColor="#F2EFE8"
        android:singleLine="true" />
    <TextView
        android:id="@+id/ezan_until"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textSize="11.5sp"
        android:textColor="#C7F2EFE8"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/ezan_widget_sample_until" />
  </LinearLayout>
</FrameLayout>
