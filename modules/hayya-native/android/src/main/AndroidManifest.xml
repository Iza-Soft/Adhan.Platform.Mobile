<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Алармата с пълния езан (етап 5) -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!-- Android 11+: за да види дали на телефона има Google Play Services (Huawei без Google) -->
  <queries>
    <package android:name="com.google.android.gms" />
    <!-- Етап 12: кои приложения за навигация са инсталирани (Настройки → Навигация) -->
    <package android:name="com.google.android.apps.maps" />
    <package android:name="com.waze" />
    <package android:name="com.here.app.maps" />
    <package android:name="com.huawei.maps.app" />
    <package android:name="app.organicmaps" />
    <!-- „Автоматично“: има ли изобщо приложение за карти (geo:) -->
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="geo" />
    </intent>
  </queries>

  <application>
    <!-- Екранът „Аларма“ върху заключения екран; отделна задача, за да не вади цялото приложение -->
    <activity
      android:name="expo.modules.hayyanative.AlarmActivity"
      android:exported="false"
      android:showWhenLocked="true"
      android:turnScreenOn="true"
      android:excludeFromRecents="true"
      android:launchMode="singleInstance"
      android:taskAffinity="${applicationId}.alarm"
      android:theme="@android:style/Theme.Material.NoActionBar" />

    <!-- Пуска езана и вибрацията, докато свърши (или „Спри“) -->
    <service
      android:name="expo.modules.hayyanative.AlarmService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />

    <!-- Будилникът на Android (setAlarmClock) вика този receiver в часа на молитвата -->
    <receiver
      android:name="expo.modules.hayyanative.AlarmReceiver"
      android:exported="false" />

    <!-- След рестарт, обновяване на приложението, смяна на часа или на разрешението – алармите наново -->
    <receiver
      android:name="expo.modules.hayyanative.BootReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
      </intent-filter>
    </receiver>
    <!-- Widget-ите (етап 8): „Следваща“ 2×2, „Денят“ 4×2, „Лента“ 4×1 -->
    <receiver
      android:name="expo.modules.hayyanative.NextPrayerWidget"
      android:label="@string/ezan_widget_next_name"
      android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/ezan_widget_next_info" />
    </receiver>
    <receiver
      android:name="expo.modules.hayyanative.DayWidget"
      android:label="@string/ezan_widget_day_name"
      android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/ezan_widget_day_info" />
    </receiver>
    <receiver
      android:name="expo.modules.hayyanative.BarWidget"
      android:label="@string/ezan_widget_bar_name"
      android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/ezan_widget_bar_info" />
    </receiver>

    <!-- Новият кадър на widget-ите в часа на всяка молитва и в полунощ -->
    <receiver
      android:name="expo.modules.hayyanative.WidgetRefreshReceiver"
      android:exported="false" />
  </application>
</manifest>
